# Copy to .env.local (ignored by git) and adjust. VITE_* values are public in the browser bundle.
# The session is an httpOnly cookie, so the frontend and the API must share a site.
# Development: the dev server proxies /api to BACKEND_URL (without the /api suffix),
# and the app talks to the dev server itself.
VITE_API_BASE_URL=http://localhost:5173
BACKEND_URL=https://backend.example.test
# Set to true when the API is reached directly through an ngrok tunnel (no proxy).
VITE_API_NGROK=false
